#!/bin/bash
set -e

echo "⚠️ Running one-off DB reset (schema load + seed)..."

# Reload schema (drops and recreates all tables, but not the DB itself)
bin/rails db:schema:load DISABLE_DATABASE_ENVIRONMENT_CHECK=1

# Run seeds
bin/rails db:seed

echo "✅ DB reset complete — solid_queue_jobs should now exist."

# Continue with your normal entrypoint afterwards
exec "$@"
